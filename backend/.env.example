# MongoDB (required for users, SMS recipients, dashboard history)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=monjed

# Optional extra CORS origins (comma-separated), e.g. http://192.168.1.5:5173
# CORS_ORIGINS=

# AI alert generation (optional — pipeline may fall back without it)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Africa's Talking SMS (required for live SMS delivery)
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=atsk_b5fce5f76a0c4372df8b8fa944ff9cefa34374c5171329ad1331c669b0d5e79e21cc0cd5
AFRICAS_TALKING_SENDER_ID=
# Comma-separated phones registered in the AT sandbox (used when Mongo has no users)
AFRICAS_TALKING_SANDBOX_PHONES=+254757711206
