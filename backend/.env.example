# MongoDB (required for users, SMS recipients, dashboard history)
# Local: mongodb://localhost:27017/
# Render: use a MongoDB Atlas connection string (Network Access must allow Render IPs or 0.0.0.0/0)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=Monjed

# Seed admin (run locally: python scripts/seed_admin.py from backend/)
# ADMIN_EMAIL=admin@monjed.org
# ADMIN_PASSWORD=ChangeMe123!
# ADMIN_DISPLAY_NAME=MONJED Admin
# ADMIN_ZONE_ID=KE

# Extra CORS origins (comma-separated). Render (*.onrender.com) and Vercel (*.vercel.app) are allowed by default.
# CORS_ORIGINS=https://my-custom-domain.com

# AI alert generation (optional — pipeline may fall back without it)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Africa's Talking SMS (required for live SMS delivery)
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_SENDER_ID=
# Comma-separated phones registered in the AT sandbox (used when Mongo has no users)
AFRICAS_TALKING_SANDBOX_PHONES=+254000000000
